+///
+/// shl patch: the spec's linear search of the table after every bit is
+/// replaced by a lookup in an index built at compile time from the same
+/// table ([`build_cxt_vlc_index`]); the first matching entry in table
+/// order wins, as with the linear search.
+fn test_match<'t>(
+    table: &'t [CxtVlcEntry],
+    index: &[u16; CXT_VLC_INDEX_LEN],
+    cq: u8,
+    cwd: u32,
+    len: u32,
+) -> Option<&'t CxtVlcEntry> {
+    if cq >= 8 || len >= 8 || cwd >= 128 {
+        return None;
+    }
+    match index[((cq as usize * 8 + len as usize) << 7) | cwd as usize] {
+        0 => None,
+        slot => table.get(slot as usize - 1),
+    }
+}
+
+/// `(cq, len, cwd)` → 1 + position of the first matching table entry, or 0.
+const CXT_VLC_INDEX_LEN: usize = 8 * 8 * 128;
+
+const fn build_cxt_vlc_index(table: &[CxtVlcEntry]) -> [u16; CXT_VLC_INDEX_LEN] {
+    let mut index = [0u16; CXT_VLC_INDEX_LEN];
+    let mut i = 0;
+    while i < table.len() {
+        let e = &table[i];
+        if e.cq < 8 && e.len < 8 && e.cwd < 128 {
+            let k = ((e.cq as usize * 8 + e.len as usize) << 7) | e.cwd as usize;
+            if index[k] == 0 {
+                index[k] = (i + 1) as u16;
+            }
+        }
+        i += 1;
+    }
+    index
 }
 
