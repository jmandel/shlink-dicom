+/// shl patch 5: the CAP marker (T.814 A.3). Only Pcap15 (Part 15) may be set; Ccap15 bits
+/// 15-14 give the code-block set, and its reserved bits 10-6 must be clear (as oxideav).
+fn cap_marker(reader: &mut BitReader<'_>) -> Option<Result<HtSet>> {
+    let length = reader.read_u16()?;
+    if length < 8 {
+        return None;
+    }
+    let pcap = reader.read_u32()?;
+    let ccap15 = reader.read_u16()?;
+    reader.skip_bytes(length as usize - 8)?;
+    if pcap != 1 << (32 - 15) || ccap15 & 0x07C0 != 0 {
+        return Some(Err(MarkerError::Unsupported.into()));
