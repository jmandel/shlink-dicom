-fn orig_bits_per_pixel(img: &Image<'_>) -> u8 {
-    let mut channel_count = img.color_space().num_channels();
-    if img.has_alpha {
-        channel_count += 1;
-    }
-    channel_count * img.original_bit_depth()
-}
